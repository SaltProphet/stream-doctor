/* Stream Doctor unified design system
   Near-black / slate, restrained orange, compact density.
   Load with: app.setStyleSheet(Path("theme.qss").read_text())
*/

QWidget {
    background-color: #0c0d0b;
    color: #c8ccc0;
    font-family: "Segoe UI", "Segoe UI Variable", system-ui, sans-serif;
    font-size: 13px;
}

QFrame, QGroupBox, QWidget#panel {
    background-color: #1a1d24;
    border: 1px solid #2a2f38;
    border-radius: 4px;
}

QFrame#sidebar, QFrame#statusStrip {
    background-color: #111318;
    border: none;
    border-right: 1px solid #2a2f38;
}

QListWidget#sidebarList {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#sidebarList::item {
    padding: 10px 14px;
    color: #c8ccc0;
}
QListWidget#sidebarList::item:selected {
    background-color: #1e2229;
    color: #ea580c;
    border-left: 3px solid #c2410c;
}
QListWidget#sidebarList::item:hover {
    background-color: #1a1d24;
}

QLabel#statusHealthy { color: #7d9b78; }
QLabel#statusUnstable, QLabel#statusWarning { color: #c2410c; }
QLabel#statusCritical { color: #b91c1c; }
QLabel#statusUnknown, QLabel#statusUnavailable { color: #8b9085; }

QPushButton {
    background-color: #1e2229;
    color: #c8ccc0;
    border: 1px solid #2a2f38;
    border-radius: 3px;
    padding: 6px 14px;
    min-height: 24px;
}
QPushButton:hover { background-color: #252a32; border-color: #3a4150; }
QPushButton#primary {
    background-color: #c2410c;
    color: #0c0d0b;
    border: none;
    font-weight: 600;
}
QPushButton#primary:hover { background-color: #ea580c; }

QLineEdit, QComboBox, QSpinBox {
    background-color: #111318;
    color: #c8ccc0;
    border: 1px solid #2a2f38;
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 22px;
}
QLineEdit:focus, QComboBox:focus { border-color: #c2410c; }

QTableWidget, QTableView {
    background-color: #1a1d24;
    alternate-background-color: #1e2229;
    gridline-color: #2a2f38;
    border: 1px solid #2a2f38;
    selection-background-color: #252a32;
    selection-color: #c8ccc0;
}
QHeaderView::section {
    background-color: #111318;
    color: #c8ccc0;
    border: none;
    border-bottom: 1px solid #2a2f38;
    padding: 6px 8px;
    font-weight: 600;
}

QWidget#overlayWindow {
    background-color: rgba(17, 19, 24, 230);
    border: 1px solid #2a2f38;
    border-radius: 6px;
}
QWidget#overlayEmergency {
    background-color: #1a0a0a;
    border: 2px solid #b91c1c;
}

QScrollBar:vertical {
    background: #111318;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #2a2f38;
    min-height: 20px;
    border-radius: 4px;
}
